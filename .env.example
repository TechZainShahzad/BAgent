JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=replace-me
JIRA_PROJECT_ALLOWLIST=KEY1,KEY2
AUTONOMY_MODE=dry_run
SESSION_SECRET=generate-a-long-random-value
